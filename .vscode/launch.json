{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug flows",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/flows",
            "args": ["data.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build flows",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}