{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug data",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/flows",
            "args": [
                "data.txt",
                "2",
                "1.0",
                "1.0",
                "1.0",
                "1.0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build flows",
            "miDebuggerPath": "/usr/bin/gdb"
        },
